# Variables del HR Assistant. Copia este archivo a .env y completa lo que falte.
# Nunca subas .env al repositorio: las claves de API_KEYS, el token de Cloudflare
# y la clave de LangSmith son secretos.

# Producción: con ENVIRONMENT=production se aplican las reglas de compliance
# (doc/compliance-checklist.md) y el producto no arranca si alguna falla.
ENVIRONMENT=development
# Clientes y claves (secreto): cliente:clave,cliente2:clave2. Vacía, toda
# pregunta responde 401. En producción cada clave necesita 16 caracteres o más.
API_KEYS=
# Peticiones por cliente por minuto; más dan 429 con Retry-After
RATE_LIMIT_PER_MINUTE=30

# Datos personales: true bloquea las preguntas con PII y enmascara la PII de las
# respuestas. En producción debe valer true o el producto no arranca.
PII_DETECTION=true
# Largo máximo de una respuesta; más largas se recortan
OUTPUT_MAX_CHARS=2000

# Modelo: fake (simulado, sin red) o gateway (Cloudflare Workers AI vía AI Gateway)
MODEL_PROVIDER=fake
AGENT_MAX_STEPS=3
MAX_QUESTION_CHARS=2000
EMPLOYEES_PATH=data/employees.json

# Observabilidad
SERVICE_NAME=hr-assistant
SLO_P95_MS=2000
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
HIDE_INPUTS=true
HIDE_OUTPUTS=true

# Cloudflare (obligatorias con MODEL_PROVIDER=gateway)
CF_ACCOUNT_ID=
CF_GATEWAY_ID=default
CF_API_TOKEN=
# Opcional: token del gateway autenticado (manda cf-aig-authorization)
CF_AIG_TOKEN=

# Modelos y palancas de costo
MODEL_SMALL=@cf/meta/llama-3.1-8b-instruct-fast
MODEL_LARGE=@cf/meta/llama-3.3-70b-instruct-fp8-fast
ROUTING=true
ROUTER_MAX_CHARS=80
HISTORY_WINDOW=6
MODEL_MAX_TOKENS=300
MODEL_TEMPERATURE=0
CACHE_TTL_SECONDS=0
PRICES_PATH=data/model_prices.json
